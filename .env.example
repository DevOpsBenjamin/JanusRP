# JanusRP Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
RUST_LOG=info,janus_server=debug,janus_core=debug,janus_mcp=debug,janus_llm=debug

# PostgreSQL Database (Postgres 16 + pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/janusrp

# LLM Providers (Optionnel pour Slice 1 avec MockLlmClient)
# Meta Muse Glimmer 30B (Arbitre / Tools MCP)
MUSE_API_URL=http://localhost:8000/v1
MUSE_API_KEY=dummy

# Qwen 3.8 (Plume / Narration littéraire en streaming)
QWEN_API_URL=http://localhost:8001/v1
QWEN_API_KEY=dummy
